{
  "buildCommand": "pnpm --filter @workspace/reset-mode run build",
  "outputDirectory": "artifacts/reset-mode/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "BASE_PATH": "/",
    "NODE_ENV": "production"
  }
}
